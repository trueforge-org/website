---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { Card } from "@astrojs/starlight/components";
import { Icon } from "@astrojs/starlight/components";

const listItemClass =
  "flex flex-row items-center gap-0 space-y-0 hover:scale-110 duration-1000 group";
const iconName = "approve-check-circle";
const iconClass = "mr-2 group-hover:animate-ping";
---

<StarlightPage
  frontmatter={{
    title: "Manic Meads",
    description: "Small Batch Mead Making — Farm-House Style",
    template: "splash",
    hero: {
      tagline: "Documenting small batch mead making, specialising in farm-house style meads.",
      actions: [
        {
          text: "Browse Recipes",
          link: "/recipes/",
          variant: "primary",
          icon: "right-arrow",
        },
        {
          text: "Read Articles",
          link: "/articles/",
          variant: "secondary",
          icon: "open-book",
        },
        {
          text: "Support Manic Meads",
          link: "https://opencollective.com/manicmeads",
          variant: "minimal",
          icon: "external",
        },
      ],
    },
  }}
>

  <div class="text-center">
    <div
      class="text-4xl max-md:text-2xl max-sm:text-xl font-extrabold border-b-4 border-tc-primary inline-block mb-10"
    >
      What is Manic Meads?
    </div>
  </div>

  <div class="max-w-3xl mx-auto text-center mb-12 text-lg">
    <p>
      Manic Meads is a project to document small batch mead making, specialising in farm-house style meads.
      A core focus is cost-effectiveness and adding taste without significant expense.
    </p>
  </div>

  <div class="text-center">
    <div
      class="text-4xl max-md:text-2xl max-sm:text-xl font-extrabold border-b-4 border-tc-primary inline-block mb-10"
    >
      Explore
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
    <Card title="Recipes" icon="star">
      <p>Our base mead recipe and variations — from cysers to pear melomels.</p>
      <li class={listItemClass}>
        <Icon name={iconName} class={iconClass} />
        <p>Base Mead workflow</p>
      </li>
      <li class={listItemClass}>
        <Icon name={iconName} class={iconClass} />
        <p>Kvapple — Apple Cyser</p>
      </li>
      <li class={listItemClass}>
        <Icon name={iconName} class={iconClass} />
        <p>Appear — Apple & Pear blend</p>
      </li>
      <li class={listItemClass}>
        <Icon name={iconName} class={iconClass} />
        <p>Pveik — 100% Pear Melomel</p>
      </li>
      <br />
      <a
        class="link-no-deco hover:scale-110 inline-flex flex-row items-center gap-1 hover:border-b-4 border-tc-primary transition-all font-bold"
        href="/recipes/"
      >
        Browse all recipes →
      </a>
    </Card>

    <Card title="Articles" icon="open-book">
      <p>Research and experiments on yeast, bacteria, and fermentation techniques.</p>
      <li class={listItemClass}>
        <Icon name={iconName} class={iconClass} />
        <p>Fermaid-O vs GoFerm</p>
      </li>
      <li class={listItemClass}>
        <Icon name={iconName} class={iconClass} />
        <p>Kveik vs Kveik-Brett Taste Test</p>
      </li>
      <li class={listItemClass}>
        <Icon name={iconName} class={iconClass} />
        <p>Malolactic Bacteria in Apple Meads</p>
      </li>
      <li class={listItemClass}>
        <Icon name={iconName} class={iconClass} />
        <p>Single vs Multi-strain Kveik</p>
      </li>
      <br />
      <a
        class="link-no-deco hover:scale-110 inline-flex flex-row items-center gap-1 hover:border-b-4 border-tc-primary transition-all font-bold"
        href="/articles/"
      >
        Read all articles →
      </a>
    </Card>
  </div>

  <br />
  <br />

  <div class="text-center">
    <div
      class="text-4xl max-md:text-2xl max-sm:text-xl font-extrabold border-b-4 border-tc-primary inline-block mb-10"
    >
      Support
    </div>
  </div>

  <div class="max-w-3xl mx-auto text-center mb-12 text-lg">
    <p>
      Enjoyed this content? Consider supporting further experiments and recipes:
    </p>
    <p>
      <a
        class="font-bold hover:underline"
        href="https://opencollective.com/manicmeads"
        target="_blank"
      >
        opencollective.com/manicmeads
      </a>
    </p>
    <p class="mt-2">Every contribution helps keep the project alive. Thank you! 🍯</p>
  </div>

</StarlightPage>
