---
import {
  titleCase,
  normalizeTrainName,
  getTrains,
  getChartCount,
} from "./utils";
import type { ChartListData } from "./utils";

interface Props {
  data?: ChartListData;
  label?: string;
  searchPlaceholder?: string;
}

const {
  data,
  label = "Charts",
  searchPlaceholder = "Search for charts and their description's",
} = Astro.props;
---

<script>
  // Build state from the DOM so this works for any data source.
  const trainCharts = new Map<string, string[]>();

  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll<HTMLElement>("[data-table-parent]").forEach((el) => {
      const train = (el.getAttribute("data-table-parent") || "").toLowerCase();
      const charts = Array.from(el.querySelectorAll<HTMLElement>("[data-chart]"))
        .map((r) => r.getAttribute("data-chart"))
        .filter((chart): chart is string => Boolean(chart));
      trainCharts.set(train, charts);
    });

    const checkboxes = document.querySelectorAll<HTMLInputElement>("input[type='checkbox']");

    checkboxes.forEach((checkbox) => {
      checkbox.addEventListener("change", function () {
        if (!checkbox.id.startsWith("tc-check-")) return;
        const train = checkbox.id.slice("tc-check-".length);
        const targetDiv = document.getElementById(
          `tc-content-${train.toLowerCase()}`
        );
        if (!targetDiv) return;

        if (checkbox.checked) {
          targetDiv.classList.remove("hidden");
        } else {
          targetDiv.classList.add("hidden");
        }
      });
    });

    const tables = document.querySelectorAll<HTMLElement>("[data-table-parent]");

    function checkTables() {
      trainCharts.forEach((charts, train) => {
        const currTable = Array.from(tables).find(
          (table) =>
            (table.getAttribute("data-table-parent") || "").toLowerCase() ===
            train
        );
        if (!currTable) return;

        if (charts.length === 0) {
          currTable.classList.add("hidden");
        } else {
          currTable.classList.remove("hidden");
        }
      });
    }

    const rows = document.querySelectorAll<HTMLElement>("[data-chart]");

    const search = document.getElementById("search") as HTMLInputElement | null;
    if (!search) return;

    search.addEventListener("input", function () {
      const query = search.value.toLowerCase();
      const regex = new RegExp(`^.*${query.split("").join(".*")}.*$`);
      rows.forEach((row) => {
        const chartName = row.getAttribute("data-chart");
        const trainName = row.getAttribute("data-train");
        const description = row.querySelector<HTMLElement>("[data-description]");

        if (!chartName || !trainName) return;

        if (
          regex.test(chartName.toLowerCase()) ||
          description?.textContent?.toLowerCase().includes(query)
        ) {
          row.classList.remove("hidden");
          const trainData = trainCharts.get(trainName);
          if (!trainData) return;
          trainData.push(chartName);
          trainCharts.set(trainName, trainData || []);
        } else {
          row.classList.add("hidden");
          const trainData = trainCharts.get(trainName);
          if (!trainData) return;
          const newCharts = trainData.filter((c) => c !== chartName);
          trainCharts.set(trainName, newCharts || []);
        }
        checkTables();
      });
    });
  });
</script>

<p class="text-center text-xl font-bold">
  Start exploring among <span class="text-tc-primary">{getChartCount(data)}</span> {label}
</p>
<ul class="ml-5 list-none flex flex-row gap-5 items-center justify-center">
  <div class="flex flex-row flex-wrap gap-5 items-center justify-center">
    {
      getTrains(data).map((train) => (
        <li>
          <input
            type="checkbox"
            checked
            name={normalizeTrainName(train)}
            id={`tc-check-${normalizeTrainName(train)}`}
          />
          <label for={normalizeTrainName(train)}>{titleCase(train)}</label>
        </li>
      ))
    }
  </div>
</ul>

<div class="flex flex-row items-center justify-center">
  <input
    class="w-[65%] m-auto px-5 rounded-lg"
    type="text"
    placeholder={searchPlaceholder}
    id="search"
  />
</div>
