---
import TrainCharts from "./TrainCharts.astro";
import {
  getTrains,
  getChartCountFromTrain,
  normalizeTrainName,
  titleCase,
} from "./utils";
import type { ChartListData } from "./utils";

interface Props {
  data?: ChartListData;
}

const { data } = Astro.props;
---

{
  getTrains(data).map((t: string) => (
    <div id={`tc-content-${normalizeTrainName(t)}`} data-table-parent={t}>
      <h2 class="!text-2xl ml-5 !mt-10">
        <a href={`#${normalizeTrainName(t)}`}>
          {titleCase(t)}{" "}
          <span class="text-lg">({getChartCountFromTrain(t, data)} Charts)</span>
        </a>
      </h2>
      <TrainCharts train={t} data={data} />
    </div>
  ))
}
