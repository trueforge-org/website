---
import Footer from "@astrojs/starlight/components/Footer.astro";
---

<Footer {...Astro.props}><slot /></Footer>
<div class="powered-by-footer">
  <a href="https://trueforge.org" rel="noopener" class="powered-by-link">
    Powered by TrueForge
  </a>
  <div class="copyright-notice">
    <a href="https://trueforge.org/general/legal/copyright/" rel="noopener" class="copyright-link">
      &copy; All rights reserved, The TrueForge Project
    </a>
  </div>
</div>

<style>
  .powered-by-footer {
    text-align: center;
    padding: 1rem 0;
    border-top: 1px solid var(--sl-color-gray-5);
    margin-top: 1rem;
    font-size: var(--sl-text-sm);
  }

  .powered-by-link {
    color: var(--sl-color-accent);
    text-decoration: none;
    font-weight: 600;
  }

  .powered-by-link:hover {
    text-decoration: underline;
  }

  .copyright-notice {
    margin-top: 0.4rem;
    font-size: var(--sl-text-xs);
  }

  .copyright-link {
    color: var(--sl-color-gray-3);
    text-decoration: none;
    font-style: italic;
  }

  .copyright-link:hover {
    text-decoration: underline;
  }
</style>
