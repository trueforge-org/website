---
import { getCharts } from "./utils";
import type { ChartListData } from "../chart-list/utils";

import Icons from "./Icons.astro";
import Title from "./Title.astro";

interface Props {
  data: ChartListData;
}

const { data } = Astro.props;
const charts = getCharts(data);
---

<!-- Charts -->
<div class="text-center">
  <Title>
    <a
      href="/containers/"
      class="!text-[var(--sl-color-text-primary)] link-no-deco"
    >
      Over <span class="text-tc-primary">{charts.length}</span> great
      <span class="text-tc-primary">Docker-Containers</span>
    </a>
  </Title>
  <!-- Pass 0 for all icons -->
  <Icons icons={charts} maxIcons={250} />
</div>

<br />
